# LOCAL DEMO only. Create .env with npm run setup:demo (random secrets).
APP_MODE=prototype
SITE_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://dongho:CHANGE_ME@127.0.0.1:54329/dongho
# Optional locally; migrations fall back to DATABASE_URL.
# On Vercel: pooled DATABASE_URL + direct DIRECT_URL, both with sslmode=require.
# See docs/vercel.md. Never copy the loopback URL to Vercel.
DIRECT_URL=
AUTH_SECRET=GENERATE_RANDOM_SECRET
AUTH_TRUST_HOST=true
PII_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX
CRON_SECRET=GENERATE_RANDOM_SECRET
MAIL_MODE=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=studio@example.invalid
ADMIN_NOTIFY_EMAIL=admin@example.invalid
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SCANNER_COMMAND=
