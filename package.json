{
  "name": "van-hoa-tranh-dong-ho",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "build:vercel": "npm run deploy:check && prisma generate && tsx scripts/prepare-vercel.ts && next build",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-db.mjs",
    "demo": "node scripts/demo.mjs",
    "test:prepare": "node scripts/test-db.mjs",
    "format": "prettier --write src scripts prisma tests *.json *.ts *.mjs",
    "format:check": "prettier --check src scripts prisma tests *.json *.ts *.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker": "tsx scripts/worker.ts",
    "setup:demo": "node scripts/setup-demo.mjs",
    "assets:prepare": "node scripts/prepare-source-assets.mjs && node scripts/configure-tour.mjs",
    "content:import": "tsx scripts/import-source-content.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@photo-sphere-viewer/autorotate-plugin": "5.15.1",
    "@photo-sphere-viewer/core": "5.15.1",
    "@photo-sphere-viewer/gyroscope-plugin": "5.15.1",
    "@photo-sphere-viewer/markers-plugin": "5.15.1",
    "@photo-sphere-viewer/visible-range-plugin": "5.15.1",
    "@prisma/client": "6.19.3",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vercel/blob": "2.8.0",
    "exceljs": "4.4.0",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.49.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.8",
    "nodemailer": "10.0.13",
    "otplib": "12.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "dotenv": "18.0.5",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "heic-convert": "2.1.0",
    "lighthouse": "13.5.0",
    "mupdf": "1.28.1",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.13": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true,
    "@parcel/watcher@2.6.0": true
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "nodemailer": "$nodemailer",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
